  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:data": "node --disable-warning=ExperimentalWarning scripts/build-data/index.ts",
    "check:data": "node --disable-warning=ExperimentalWarning scripts/build-data/index.ts --check",
    "dev": "npm run build:data && vite",
